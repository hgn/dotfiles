# mkdir /tmp/$rand && cd
mcdt() {
    local tmp
    tmp=$(head -n 1000 /usr/share/dict/words |
          sort -R |
          tr -d "'" |
          tr '[:upper:]' '[:lower:]' |
          head -n 1)
    tmp="/tmp/${tmp:-tmp-$$}"
    mkdir -p -- "$tmp" && cd -- "$tmp" && echo "Created and changed directory to $tmp"
}

# Copy files/directories into /tmp (uses CoW reflink when supported)
cpt() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: cpt <file>..." >&2
        return 1
