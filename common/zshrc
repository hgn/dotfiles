show-archive() {
    if [[ -f $1 ]]; then
        case $1 in
            *.tar.gz|*.tgz) tar -ztf "$1" ;;
            *.tar.xz|*.txz) tar -Jtf "$1" ;;
            *.tar.zst)      tar --zstd -tf "$1" ;;
            *.tar)          tar -tf "$1" ;;
            *.zip)          unzip -l "$1" ;;
            *.bz2)          bzless "$1" ;;
            *.tbz2)         tar -jtf "$1" ;;
            *)              echo "'$1': unsupported archive format" ;;
        esac
    else
        echo "'$1' is not a valid archive"
    fi
}

# Exchange ' ' for '_' in filenames
unspaceit() {
    local _spaced _underscored
    for _spaced in "$@"; do
        [[ -f $_spaced ]] || continue
        _underscored=${_spaced// /_}
        if [[ $_underscored != $_spaced ]]; then
            mv -i -- "$_spaced" "$_underscored"
        fi
    done
}

