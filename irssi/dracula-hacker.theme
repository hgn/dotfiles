# Dracula Hacker: a high-contrast true-colour theme for Irssi 1.4 and Kitty.
# Palette: https://draculatheme.com/contribute
#
# When testing changes, the easiest way to reload the theme is with /RELOAD.
# This reloads the configuration file too, so if you did any changes remember
# to /SAVE it first. Remember also that /SAVE overwrites the theme file with
# old data so keep backups :)

# TEMPLATES:

# The real text formats that irssi uses are the ones you can find with
# /FORMAT command. Back in the old days all the colors and texts were mixed
# up in those formats, and it was really hard to change the colors since you
# might have had to change them in tens of different places. So, then came
# this templating system.

# Now the /FORMATs don't have any colors in them, and they also have very
# little other styling. Most of the stuff you need to change is in this
# theme file. If you can't change something here, you can always go back
# to change the /FORMATs directly, they're also saved in these .theme files.

# So .. the templates. They're those {blahblah} parts you see all over the
# /FORMATs and here. Their usage is simply {name parameter1 parameter2}.
# When irssi sees this kind of text, it goes to find "name" from abstracts
# block below and sets "parameter1" into $0 and "parameter2" into $1 (you
# can have more parameters of course). Templates can have subtemplates.
# Here's a small example:
#   /FORMAT format hello {colorify {underline world}}
#   abstracts = { colorify = "%G$0-%n"; underline = "%U$0-%U"; }
# When irssi expands the templates in "format", the final string would be:
#   hello %G%Uworld%U%n
# ie. underlined bright green "world" text.
# and why "$0-", why not "$0"? $0 would only mean the first parameter,
# $0- means all the parameters. With {underline hello world} you'd really
# want to underline both of the words, not just the hello (and world would
# actually be removed entirely).

# COLORS:

# You can find definitions for the color format codes in docs/formats.txt.

# There's one difference here though. %n format. Normally it means the
# default color of the terminal (white mostly), but here it means the
# "reset color back to the one it was in higher template". For example
# if there was /FORMAT test %g{foo}bar, and foo = "%Y$0%n", irssi would
# print yellow "foo" (as set with %Y) but "bar" would be green, which was
# set at the beginning before the {foo} template. If there wasn't the %g
# at start, the normal behaviour of %n would occur. If you _really_ want
# to use the terminal's default color, use %N.

#############################################################################

# default foreground color (%N) - -1 is the "default terminal color"
default_color = "-1";

# print timestamp/servertag at the end of line, not at beginning
info_eol = "false";

# these characters are automatically replaced with specified color
# (dark grey by default)
replaces = { "[]=" = "%Z6272a4$*%n"; };

abstracts = {
  ##
  ## generic
  ##

  # text to insert at the beginning of each non-message line
  line_start = "%Z6272a4›%n ";

  # timestamp styling, nothing by default
  timestamp = "%Z6272a4$*%n";

  # any kind of text that needs hilighting, default is to bold
  hilight = "%Zf1fa8c%_$*%_%n";

  # any kind of error message, default is bright red
  error = "%Zff5555%_$*%_%n";

  # channel name is printed
  channel = "%Z8be9fd$*%n";

  # nick is printed
  nick = "%Zbd93f9$*%n";

  # nick host is printed
  nickhost = "%Z6272a4[$*]%n";

  # server name is printed
  server = "%Z50fa7b$*%n";

  # some kind of comment is printed
  comment = "%Z6272a4[$*]%n";

  # reason for something is printed (part, quit, kick, ..)
  reason = "{comment %Zffb86c$*%n}";

  # mode change is printed ([+o nick])
  mode = "%Zff79c6[$*]%n";

  ##
  ## channel specific messages
  ##

  # highlighted nick/host is printed (joins)
  channick_hilight = "%Z50fa7b$*%n";
  chanhost_hilight = "{nickhost %Z6272a4$*%n}";

  # nick/host is printed (parts, quits, etc.)
  channick = "%Zbd93f9$*%n";
  chanhost = "{nickhost $*}";

  # highlighted channel name is printed
  channelhilight = "%Z8be9fd%_$*%_%n";

  # ban/ban exception/invite list mask is printed
  ban = "%Zff5555$*%n";

  ##
  ## messages
  ##

  # the basic styling of how to print message, $0 = nick mode, $1 = nick
  msgnick = "%Z6272a4<%n$0$1-%Z6272a4>%n %|";

  # message from you is printed. "ownnick" specifies the styling of the
  # nick ($0 part in msgnick) and "ownmsgnick" specifies the styling of the
  # whole line.

  # Example1: You want the message text to be green:
  #  ownmsgnick = "{msgnick $0 $1-}%g";
  # Example2.1: You want < and > chars to be yellow:
  #  ownmsgnick = "%Y{msgnick $0 $1-%Y}%n";
  #  (you'll also have to remove <> from replaces list above)
  # Example2.2: But you still want to keep <> grey for other messages:
  #  pubmsgnick = "%K{msgnick $0 $1-%K}%n";
  #  pubmsgmenick = "%K{msgnick $0 $1-%K}%n";
  #  pubmsghinick = "%K{msgnick $1 $0$2-%n%K}%n";
  #  ownprivmsgnick = "%K{msgnick  $*%K}%n";
  #  privmsgnick = "%K{msgnick  %R$*%K}%n";

  # $0 = nick mode, $1 = nick
  ownmsgnick = "{msgnick $0 $1-}";
  ownnick = "%Z50fa7b%_$*%_%n";

  # public message in channel, $0 = nick mode, $1 = nick
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "%Zbd93f9$*%n";

  # public message in channel meant for me, $0 = nick mode, $1 = nick
  pubmsgmenick = "{msgnick $0 $1-}";
  menick = "%Zf1fa8c%_$*%_%n";

  # public highlighted message in channel
  # $0 = highlight color, $1 = nick mode, $2 = nick
  pubmsghinick = "{msgnick $1 $0$2-%n}";

  # channel name is printed with message
  msgchannel = "%Z6272a4::%Z8be9fd$*%n";

  # private message, $0 = nick, $1 = host
  privmsg = "%Zff79c6DM%n %Zbd93f9$0%n %Z6272a4[$1-]%n ";

  # private message from you, $0 = "msg", $1 = target nick
  ownprivmsg = "%Z50fa7bDM%n %Zbd93f9$1-%n ";

  # own private message in query
  ownprivmsgnick = "{msgnick  $*}";
  ownprivnick = "%Z50fa7b%_$*%_%n";

  # private message in query
  privmsgnick = "{msgnick  %Zff79c6$*%n}";

  ##
  ## Actions (/ME stuff)
  ##

  # used internally by this theme
  action_core = "%Zff79c6%_ * $*%_%n";

  # generic one that's used by most actions
  action = "{action_core $*} ";

  # own action, both private/public
  ownaction = "{action $*}";

  # own action with target, both private/public
  ownaction_target = "{action_core $0}%K:%c$1%n ";

  # private action sent by others
  pvtaction = "%_ (*) $*%n ";
  pvtaction_query = "{action $*}";

  # public action sent by others
  pubaction = "{action $*}";


  ##
  ## other IRC events
  ##

  # whois
  whois = "%# %Z6272a4$[10]0%n %Z50fa7b→%n $1-";

  # notices
  ownnotice = "%Zffb86cNOTICE%n %Zbd93f9$0%n %Z6272a4[$1-]%n ";
  notice = "%Zffb86cNOTICE%n %Zbd93f9$*%n ";
  pubnotice_channel = "%Z6272a4::%Z8be9fd$*%n";
  pvtnotice_host = "%Z6272a4[$*]%n";
  servernotice = "%Z50fa7b!%n $* ";

  # CTCPs
  ownctcp = "%Zffb86cCTCP%n %Zbd93f9$0%n %Z6272a4[$1-]%n ";
  ctcp = "%Zffb86c$*%n";

  # wallops
  wallop = "%Zff79c6%_$*%_%n: ";
  wallop_nick = "%n$*";
  wallop_action = "%_ * $*%n ";

  # netsplits
  netsplit = "%Zff5555$*%n";
  netjoin = "%Z50fa7b$*%n";

  # /names list
  names_prefix = "";
  names_nick = "[%_$0%_$1-] ";
  names_nick_op = "%Zff79c6{names_nick $*}%n";
  names_nick_halfop = "%Zbd93f9{names_nick $*}%n";
  names_nick_voice = "%Zf1fa8c{names_nick $*}%n";
  names_users = "%Z6272a4[%n%Z50fa7b$*%n%Z6272a4]%n";
  names_channel = "%Z8be9fd$*%n";

  # DCC
  dcc = "%Z50fa7b$*%n";
  dccfile = "%_$*%_";

  # DCC chat, own msg/action
  dccownmsg = "[%r$0%K($1-%K)%n] ";
  dccownnick = "%R$*%n";
  dccownquerynick = "%_$*%n";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%K:%c$1%n ";

  # DCC chat, others
  dccmsg = "[%G$1-%K(%g$0%K)%n] ";
  dccquerynick = "%G$*%n";
  dccaction = "%_ (*dcc*) $*%n %|";

  ##
  ## statusbar
  ##

  # default background for all statusbars. You can also give
  # the default foreground color for statusbar items.
  sb_background = "%z282a36%Zf8f8f2";
  window_border = "%z44475a%Z6272a4";

  # default backround for "default" statusbar group
  sb_default_bg = "%z282a36%Zf8f8f2";
  # background for prompt / input line
  sb_prompt_bg = "%z282a36%Zf8f8f2";
  # background for info statusbar
  sb_info_bg = "%z282a36%Zf8f8f2";
  # background for topicbar (same default)
  sb_topic_bg = "%z282a36%Z50fa7b";

  # text at the beginning of statusbars. "sb" already puts a space there,
  # so we don't use anything by default.
  sbstart = " %Zbd93f9›%n ";
  # text at the end of statusbars. Use space so that it's never
  # used for anything.
  sbend = " %Zbd93f9‹%n ";

  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";

  prompt = "%Z6272a4[%n%Z50fa7b$S%n%Z6272a4:%n%Z8be9fd$*%n%Z6272a4]%n %Zff79c6❯%n ";

  sb = " %Z6272a4│%n $*";
  sbmode = " %Zff79c6+$*%n";
  sbaway = " %Zffb86caway%n";
  sbservertag = " %Z6272a4@%n%Z50fa7b$0%n";
  sbnickmode = "%Zff79c6$0%n";

  # activity in statusbar

  # ',' separator
  sb_act_sep = "%Z6272a4$*%n";
  # no activity
  sb_act_none = "%Z6272a4$*%n";
  # normal text
  sb_act_text = "%Z8be9fd$*%n";
  # public message
  sb_act_msg = "%Zf1fa8c$*%n";
  # hilight
  sb_act_hilight = "%Zff79c6%_$*%_%n";
  # hilight with specified color, $0 = color, $1 = text
  sb_act_hilight_color = "$0$1-%n";

  # channel population, provided by usercount.pl
  sb_usercount = "{sb %Z8be9fd$0%n %Z6272a4users%n $1-}";
  sb_uc_ircops = "%Zff5555*%n$*";
  sb_uc_ops = "%Zff79c6@%n$*";
  sb_uc_halfops = "%Zbd93f9%%%n$*";
  sb_uc_voices = "%Zf1fa8c+%n$*";
  sb_uc_normal = "%Z6272a4·%n$*";
  sb_uc_space = " ";
};

formats = {
  "fe-common/core" = {
    # nickcolor_expando_simple.pl supplies $nickcolor for incoming messages.
    pubmsg = "{pubmsgnick $2 {pubnick $nickcolor$[-12]0}}%Zf8f8f2$1%n";
    pubmsg_me = "{pubmsgmenick $2 {menick $[-12]0}}%Zf8f8f2$1%n";
    pubmsg_hilight = "{pubmsghinick $0 $3 $nickcolor$[-12]1}%Zf8f8f2$2%n";
    own_msg = "{ownmsgnick $2 {ownnick $[-12]0}}%Zf8f8f2$1%n";
    msg_private = "{privmsg $nickcolor$0 $1}%Zf8f8f2$2%n";
    msg_private_query = "{privmsgnick $nickcolor$0}%Zf8f8f2$2%n";
    daychange = "%Z6272a4──────────%n %Zbd93f9Day changed to %%D%n %Z6272a4──────────%n";
  };

  "Irssi::Script::adv_windowlist" = {
    awl_display_header = "%Z50fa7b%_◆ $C%_%n";
    awl_display_nokey = "%Z44475a│%n %Z6272a4$N%n $H$C$S";
    awl_display_key = "%Z44475a│%n %Z6272a4$Q%n $H$C$S";
    awl_display_nokey_visible = "%Zbd93f9│%n %Zbd93f9$N%n $H$C$S";
    awl_display_key_visible = "%Zbd93f9│%n %Zbd93f9$Q%n $H$C$S";
    awl_display_nokey_active = "%Zff79c6%_▶ $N%n %Zf8f8f2%_$C%_%n";
    awl_display_key_active = "%Zff79c6%_▶ $Q%n %Zf8f8f2%_$C%_%n";
    awl_name_display = "$0";
    awl_separator = "";
    awl_abbrev_chars = "…·";
  };
};
