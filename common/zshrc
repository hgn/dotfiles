    cp -a --reflink=auto -- "$@" /tmp/
}

# Interactive ripgrep + fzf code search -> open match in nvim at exact line
rgf() {
    local sel file line
    sel=$(rg --column --line-number --no-heading --color=always --smart-case "${*:-}" |
          fzf --ansi --height=80% --delimiter : \
              --preview 'batcat --style=numbers --color=always --highlight-line {2} {1}' \
              --preview-window 'up,60%,border-bottom,+{2}+3/3,~3') || return
    file=${sel%%:*}
    line=${${sel#*:}%%:*}
    nvim "+$line" -- "$file"
}

# Fuzzy file finder with bat preview -> open in nvim
vf() {
    local file
    file=$(fdfind --type f --hidden --follow --exclude .git |
           fzf --height=80% \
               --preview 'batcat --style=numbers --color=always {}' \
               --preview-window 'right,60%') || return
    nvim -- "$file"
}

# Jump to git repository root
gr() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not in a git repo" >&2; return 1; }
    cd "$root"
}

# Interactive git log browser with delta diff preview
glg() {
    git log --graph --color=always \
        --format='%C(auto)%h%d %s %C(black)%C(bold)%cr%C(reset)' "$@" |
    fzf --ansi --no-sort --reverse --tiebreak=index --height=80% \
        --preview 'git show --color=always $(echo {} | grep -oE "[a-f0-9]{7,}" | head -1) | delta --width=$FZF_PREVIEW_COLUMNS' \
        --preview-window 'right,60%' \
        --bind 'enter:execute(git show --color=always $(echo {} | grep -oE "[a-f0-9]{7,}" | head -1) | delta --paging=always)'
}

# Universal archive extractor
extract() {
    local f
    if [[ $# -eq 0 ]]; then
        echo "Usage: extract <archive>..." >&2
        return 1
    fi
    for f in "$@"; do
        [[ -f $f ]] || { echo "'$f' is not a valid file" >&2; continue; }
        case $f in
            *.tar.bz2|*.tbz2) tar xjf "$f" ;;
            *.tar.gz|*.tgz)   tar xzf "$f" ;;
            *.tar.xz|*.txz)   tar xJf "$f" ;;
            *.tar.zst)        tar --zstd -xf "$f" ;;
            *.tar)            tar xf "$f" ;;
            *.bz2)            bunzip2 "$f" ;;
            *.gz)             gunzip "$f" ;;
            *.xz)             unxz "$f" ;;
            *.zst)            unzstd "$f" ;;
            *.zip)            unzip "$f" ;;
            *.7z)             7z x "$f" ;;
            *)                echo "'$f': unsupported archive format" >&2 ;;
        esac
    done
}

# Interactive process killer via fzf (default signal: TERM / 15)
fkill() {
    local pids
    pids=$(ps -u "$USER" -o pid,pcpu,pmem,comm,args --sort=-pcpu |
           sed 1d | fzf -m --height=40% | awk '{print $1}') || return
    echo "$pids" | xargs kill "-${1:-15}"
}

