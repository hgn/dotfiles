// Shared waybar modules (Hyprland + niri) - Tokyo Night
{
    "custom/launcher": {
        "format": "",
        "tooltip-format": "Programme (Super)",
        "on-click": "fuzzel"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
            "default": "·"
        },
        "persistent-workspaces": { "*": 6 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
            "default": "·"
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "min-length": 30,
        "align": 0,
        "separate-outputs": true,
        "rewrite": { "": "  Desktop" }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 30,
        "min-length": 30,
        "align": 0,
        "rewrite": { "": "  Desktop" }
    },

    "clock": {
        "format": "{:L%H:%M  <span color='#565f89'>·</span>  %A, %d.%m.}",
        "format-alt": "{:L%H:%M:%S  <span color='#565f89'>·</span>  KW %V  <span color='#565f89'>·</span>  %d.%m.%Y}",
        "interval": 1,
        "locale": "de_DE.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#bb9af7'><b>{}</b></span>",
                "weeks":    "<span color='#565f89'>KW{}</span>",
                "weekdays": "<span color='#7dcfff'><b>{}</b></span>",
                "days":     "<span color='#a9b1d6'>{}</span>",
                "today":    "<span color='#1a1b26' background='#7aa2f7'><b> {} </b></span>"
            }
        },
        "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    },

    // WireGuard to the Fritzbox: click toggles
    "custom/vpn": {
        "exec": "/home/pfeifer/.local/share/wm/bin/wm-vpn",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "on-click": "/home/pfeifer/.local/share/wm/bin/wm-vpn toggle"
    },

    "custom/weather": {
        "exec": "/home/pfeifer/.local/share/wm/bin/wm-weather",
        "return-type": "json",
        "interval": 900,
        "on-click": "xdg-open https://wttr.in/?lang=de"
    },

    // per-core load as mini bars (8 threads)
    "cpu": {
        "interval": 2,
        "format": "  {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip-format": "CPU {usage}%  ·  {avg_frequency} GHz\nLast {load}",
        "states": { "high": 75 }
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {used:0.1f}G",
        "min-length": 8,
        "align": 1,
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "states": { "high": 80 }
    },

    "temperature": {
        "interval": 3,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "  {temperatureC}°",
        "format-critical": "  {temperatureC}°",
        "tooltip-format": "CPU-Package {temperatureC} °C"
    },

    // fixed width + right aligned, so changing rates don't shift the bar
    "network#down": {
        "interval": 2,
        "format": "󰇚 {bandwidthDownBytes}",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format": "{ifname}  ·  Download {bandwidthDownBits}",
        "min-length": 11,
        "max-length": 11,
        "align": 1
    },

    "network#up": {
        "interval": 2,
        "format": "󰕒 {bandwidthUpBytes}",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format": "{ifname}  ·  Upload {bandwidthUpBits}",
        "min-length": 11,
        "max-length": 11,
        "align": 1
    },

    "tray": { "icon-size": 18, "spacing": 10 },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Wachhalten: an (kein Sperren/Standby)",
        "tooltip-format-deactivated": "Wachhalten: aus"
    },

    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  kein IP",
        "format-disconnected": "󰤭  offline",
        "format-disabled": "󰤮  aus",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}  ·  {signalStrength}%  ·  {frequency} GHz\n{ipaddr}/{cidr}  via {gwaddr}\n 󰇚 {bandwidthDownBits}   󰕒 {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
        "max-length": 28,
        "on-click": "/home/pfeifer/.local/share/wm/bin/wm-wifi",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  stumm",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "/home/pfeifer/.local/share/wm/bin/wm-osd vol-mute"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"],
        "on-scroll-up": "brightnessctl -q -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -q -e4 -n2 set 5%-"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Energieprofil: {profile}\nKlick zum Wechseln",
        "tooltip": true,
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-full": "󰁹  voll",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Sperren · Standby · Abmelden · Neustart · Aus",
        "on-click": "/home/pfeifer/.local/share/wm/bin/wm-power"
    }
}
