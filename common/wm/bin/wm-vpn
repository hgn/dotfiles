#!/bin/sh
# WireGuard tunnel to the Fritzbox (NetworkManager connection "fritz-wg").
#   wm-vpn          -> waybar JSON status
#   wm-vpn toggle   -> up/down, notify, refresh waybar (signal 9)
CON=fritz-wg
ICON="󰖂"

active() { nmcli -t -f NAME connection show --active | grep -qxF "$CON"; }

case "${1:-status}" in
    toggle)
        if active; then
            nmcli connection down "$CON" >/dev/null 2>&1 \
                && notify-send -a VPN -i network-vpn-disconnected "VPN getrennt" "$CON"
        elif out=$(nmcli connection up "$CON" 2>&1); then
            notify-send -a VPN -i network-vpn "VPN verbunden" "$CON · Verkehr läuft über die Fritzbox"
        else
            notify-send -a VPN -u critical -i network-vpn-error "VPN fehlgeschlagen" "$out"
        fi
        pkill -RTMIN+9 -x waybar 2>/dev/null || true
        qs ipc call shell refreshVpn >/dev/null 2>&1 || true
        ;;
    *)
        if active; then
            printf '{"text":"%s","class":"on","tooltip":"VPN %s aktiv\\nKlick: trennen"}\n' "$ICON" "$CON"
        else
            printf '{"text":"%s","class":"off","tooltip":"VPN aus\\nKlick: über die Fritzbox verbinden"}\n' "$ICON"
        fi
        ;;
esac
