#!/usr/bin/env bash
set -euo pipefail

echo -e "Starting email-classify: \e[32mcategorizing\e[0m emails via notmuch..."
START_TIME=$(date +%s.%N)

# Phase 1: base folder tags (only touch messages missing the expected tags)
notmuch tag --batch <<'EOF'
+linux-pm +list -inbox -- folder:Lists.linux-pm and (not tag:linux-pm or not tag:list or tag:inbox)
+lkml +list -inbox -- folder:Lists.lkml and (not tag:lkml or not tag:list or tag:inbox)
+keep-infty -- tag:flagged and not tag:keep-infty
EOF

# Phase 2: topic and retention tags (sees Phase 1 commits)
notmuch tag --batch <<'EOF'
+keep-longer +linux-pm-intel -- tag:linux-pm and (not tag:keep-longer or not tag:linux-pm-intel) and (subject:*intel* or subject:*rapl*)
+keep-infty -- tag:lkml and not tag:keep-infty and to:hagen.pfeifer@jauu.net
+keep-longer +linux-perf -- tag:lkml and (not tag:keep-longer or not tag:linux-perf) and subject:perf
+keep-longer +linux-trace -- tag:lkml and (not tag:keep-longer or not tag:linux-trace) and (subject:trace or subject:ftrace)
+keep-longer +linux-bpf -- tag:lkml and (not tag:keep-longer or not tag:linux-bpf) and (subject:ebpf or subject:bpf)
EOF

# Phase 3: mark expired messages as killed (sees all keep-* tags from Phase 2)
notmuch tag --batch <<'EOF'
+killed -- tag:linux-pm and not tag:killed and not tag:keep-longer and date:..365days
+killed -- tag:linux-pm and not tag:killed and date:..1024days
+killed -- tag:lkml and not tag:killed and not tag:keep-longer and not tag:keep-infty and date:..30days
+killed -- tag:lkml and not tag:killed and not tag:keep-infty and date:..365days
+killed -- folder:Trash and not tag:killed and not tag:keep-infty and date:..120days
EOF

END_TIME=$(date +%s.%N)
ELAPSED=$(awk -v t1="$START_TIME" -v t2="$END_TIME" 'BEGIN{printf "%.2f", t2-t1}')
echo -e "    completed in \e[36m$ELAPSED\e[0m seconds"
