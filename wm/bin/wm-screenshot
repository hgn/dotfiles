#!/bin/sh
# Screenshot to ~/Bilder/Screenshots (XDG pictures dir) + clipboard.
# usage: wm-screenshot area|screen
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
f="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "${1:-area}" in
    area)   geom=$(slurp -d -b 1a1b2688 -c 7aa2f7ff -w 2) || exit 0
            grim -g "$geom" "$f" ;;
    screen) grim "$f" ;;
esac
[ -s "$f" ] || exit 1
wl-copy --type image/png < "$f"
notify-send -a wm-screenshot -i "$f" "Screenshot gespeichert" "$(basename "$f") · in Zwischenablage"
