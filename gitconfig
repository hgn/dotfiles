[alias]
    b = branch -av
    cleanall = clean --force -d -x
    cs = commit --signoff --verbose
    diffstat = diff --stat -r
    gb = branch -av
    graphviz = "!f() { echo 'digraph git {' ; git log --pretty='format:  %h -> { %p }' \"$@\" | sed 's/[0-9a-f][0-9a-f]*/\"&\"/g' ; echo '}'; }; f"
    g = grep --break --heading --line-number --show-function --before-context 10 --after-context 2
    ignored = ls-files -o -i --exclude-standard
    last = log -1 HEAD
    lc = log ORIG_HEAD.. --stat --no-merges  # New commits after fetch, excluding merges
    lg = log --color --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    log-graph = log --all --graph --decorate
    llog = log --date=local
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    lolap = log --graph --decorate --pretty=oneline --abbrev-commit --all --patch
    merge = merge --progress --verbose
    pull = pull --stat
    quick-stats = '! ~/bin/git-quick-stats'
    serve = !git daemon --reuseaddr --verbose --base-path=. --export-all ./.git
    stash = stash --include-untracked
    st = status --short --branch
    tagsorted = tag --sort=-creatordate
    w = !git branch -a && git log --branches --oneline --graph --decorate --simplify-by-decoration --since='2 months ago'
    wdiff = diff --color-words
    where = "!f() { git rev-parse --abbrev-ref HEAD; git log -1 --pretty=%s;}; f"
    who = shortlog -s --
    changes = "!sh -c 'git status | sed -n \"/Untracked/N;//N;1,//d;s/^#/?/p\"; git diff --name-status -r \"$@\"' -"

[apply]
    whitespace = fix

[branch]
    sort = -committerdate

[color]
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[commit]
    verbose = true
    signoff = yes

[core]
    legacyheaders = false
    excludesfile = $HOME/.gitignore
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    editor = nvim

[credential]
    helper = cache --timeout=7200  # Cache credentials for 2 hours

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicprefix = true  # Use i/w/c/o instead of a/b/c/d
    renames = true
    submodule = log

[fetch]
    all = true
    prune = true
    pruneTags = true

[giggle]
    main-window-maximized = false
    main-window-geometry = 1680x1050+0+0
    history-view-vpane-position = 331
    main-window-view = HistoryView
    file-view-vpane-position = 241

[grep]
    extendRegexp = true

[help]
    autocorrect = prompt

[http]
    postBuffer = 157286400
    # sslVerify = false  # Disable cert verification only if absolutely needed

[https]
    # proxy = https://USERNAME:PASSWORD@proxy.example.net:80
    # sslVerify = false  # Same caution as above

[init]
    defaultBranch = main

[merge]
    tool = vimdiff
    log = true
    summary = true
    stat = true

[mergetool]
    keepBackup = false

[push]
    default = upstream
    autoSetupRemote = true
    followTags = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[repack]
    usedeltabaseoffset = true

[rerere]
    enabled = true
    autoupdate = true

[sendemail]
    bcc = hagen@jauu.net
    smtpencryption = ssl
    smtpserver = smtp.mailbox.org
    smtpuser = hagen@jauu.net
    smtpserverport = 465
    confirm = auto
    chainreplyto = false

[status]
    submoduleSummary = true

[tag]
    sort = version:refname
