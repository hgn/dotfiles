#!/usr/bin/env python3
"""Tiny zero-dependency HTTP endpoint to receive links/text from Android.

Endpoints (authenticated via X-Token header or ?token=...):
  POST /open   - extract first http(s) URL -> copy to clipboard + open in Firefox
                 (if payload has no URL, copy text to clipboard)
  POST /clip   - copy raw payload to Wayland clipboard only (no browser)
  GET  /health - liveness check (no auth)

Token is read from $LINKDROP_TOKEN_FILE or ~/.config/linkdrop/token.
"""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs
import hmac
import os
import re
import socket
import subprocess
import sys

BIND = os.environ.get("LINKDROP_BIND", "::")
PORT = int(os.environ.get("LINKDROP_PORT", "8765"))
TOKEN_FILE = os.path.expanduser(
    os.environ.get("LINKDROP_TOKEN_FILE", "~/.config/linkdrop/token")
)
MAX_BODY = 64 * 1024
URL_RE = re.compile(r"https?://[^\s<>\"'\]\)]+")


def load_token() -> str:
    try:
        with open(TOKEN_FILE, "r", encoding="utf-8") as f:
            tok = f.read().strip()
        if not tok:
            raise ValueError("empty token")
        return tok
    except Exception as e:
        sys.exit(f"linkdrop: cannot read token from {TOKEN_FILE}: {e}")


def wl_copy(text: str) -> None:
    try:
        p = subprocess.Popen(
            ["wl-copy"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        assert p.stdin is not None
        p.stdin.write(text.encode("utf-8"))
        p.stdin.close()
    except Exception as e:
        print(f"wl-copy failed: {e}", file=sys.stderr, flush=True)


def notify(title: str, body: str, icon: str = "phone") -> None:
    try:
        subprocess.Popen(
            ["notify-send", "-a", "LinkDrop", "-i", icon, title, body[:240]],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        print(f"notify-send failed: {e}", file=sys.stderr, flush=True)


def open_url(url: str) -> None:
    try:
        subprocess.Popen(
            ["firefox", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        print(f"firefox failed: {e}", file=sys.stderr, flush=True)


TOKEN = load_token()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        print(f"{self.address_string()} - {fmt % args}", flush=True)

    def _reply(self, code: int, body: str) -> None:
        raw = (body + "\n").encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _authorized(self, parsed) -> bool:
        got = self.headers.get("X-Token", "").strip()
        if not got:
            got = parse_qs(parsed.query).get("token", [""])[0].strip()
        return bool(got) and hmac.compare_digest(got, TOKEN)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path == "/health":
            self._reply(200, "ok")
        else:
            self._reply(404, "not found")

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path not in ("/open", "/clip"):
            self._reply(404, "not found")
            return
        if not self._authorized(parsed):
            self._reply(401, "unauthorized")
            return
        length = int(self.headers.get("Content-Length", "0") or "0")
        if length <= 0 or length > MAX_BODY:
            self._reply(400, "empty or oversized body")
            return
        payload = self.rfile.read(length).decode("utf-8", errors="replace").strip()
        if not payload:
            self._reply(400, "empty payload")
            return

        if parsed.path == "/clip":
            wl_copy(payload)
            notify("Zwischenablage vom Handy", payload, "edit-paste")
            self._reply(200, "copied")
            return

        m = URL_RE.search(payload)
        if m:
            url = m.group(0).rstrip(".,;:!?")
            wl_copy(url)
            open_url(url)
            notify("Link vom Handy geöffnet", url, "web-browser")
            self._reply(200, f"opened: {url}")
        else:
            wl_copy(payload)
            notify("Text vom Handy kopiert", payload, "edit-paste")
            self._reply(200, "copied (no url)")


class DualStackHTTPServer(ThreadingHTTPServer):
    address_family = socket.AF_INET6

    def server_bind(self) -> None:
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


def main() -> None:
    cls = DualStackHTTPServer if ":" in BIND else ThreadingHTTPServer
    server = cls((BIND, PORT), Handler)
    print(f"linkdrop listening on [{BIND}]:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
