{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,
    "reload_style_on_change": true,
    "fixed-center": false,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/weather", "memory", "temperature"],
    "modules-right": ["tray", "idle_inhibitor", "network", "bluetooth", "wireplumber",
                      "backlight", "power-profiles-daemon", "battery", "custom/power"]
}
