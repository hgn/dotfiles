# mako - Tokyo Night
font=JetBrainsMono Nerd Font 12
background-color=#1a1b26e6
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #7aa2f7aa
border-size=2
border-radius=14
padding=14,18
margin=14
width=420
height=180
icons=1
max-icon-size=48
default-timeout=6000
layer=overlay
anchor=top-right
format=<b>%s</b>\n%b

[urgency=low]
border-color=#414868

[urgency=critical]
border-color=#f7768e
default-timeout=0

# volume / brightness OSD: centered at bottom with progress bar
[app-name=wm-osd]
anchor=bottom-center
margin=0,0,120,0
width=340
height=90
border-color=#bb9af7
progress-color=over #bb9af7cc
format=<b>%s</b>   %b
default-timeout=1200

[app-name=wm-screenshot]
border-color=#9ece6a

[mode=do-not-disturb]
invisible=1
